# ---------------------------------------------------------------------------
# Resume Import (AI) configuration
#
# Copy this file to `.env.local` and fill in your key, then restart `npm run dev`
# (Vite only reads env vars at startup).
# ---------------------------------------------------------------------------

# Google Gemini API key — get one free at https://aistudio.google.com/apikey
# NOTE: anything prefixed with VITE_ is embedded in the client bundle and is
# therefore PUBLIC in a deployed build. Use this for local development only.
# For production, leave it empty and set VITE_AI_PROXY_URL instead.
VITE_GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest (rolling alias).
VITE_GEMINI_MODEL=

# Optional. When set, the app posts to this endpoint instead of calling Gemini
# directly, and the provider key lives on the server. Example:
#   VITE_AI_PROXY_URL=/api/parse-resume
VITE_AI_PROXY_URL=
